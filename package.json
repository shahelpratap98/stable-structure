{
  "name": "stable-structure",
  "version": "1.0.0",
  "private": true,
  "description": "Stable Structure Limited: static marketing site (build/generate.js) + staff portal (Next.js, /portal)",
  "scripts": {
    "build:site": "node build/generate.js",
    "build:public": "node build/generate.js && node build/copy-public.mjs",
    "dev": "node build/copy-public.mjs && next dev",
    "build": "node build/generate.js && node build/copy-public.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "sync": "node build/fetch-facebook.js",
    "sync:build": "node build/fetch-facebook.js && node build/generate.js"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "exceljs": "^4.4.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
