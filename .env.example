# Supabase project (Project Settings -> API). Both values are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The site origin, no trailing slash and no /portal. Used in invite and email links.
NEXT_PUBLIC_APP_URL=https://www.stablestructure.co.nz
# Server only. Needed for inviting staff (Phase 1). Never commit, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: outbound email through Resend (invites, returned entries, invoices).
# EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Stable Structure Portal <portal@stablestructure.co.nz>"
