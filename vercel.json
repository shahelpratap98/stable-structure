{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build/generate.js",
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },

    { "source": "/build", "destination": "/", "permanent": true },
    { "source": "/build/:path*", "destination": "/", "permanent": true },
    { "source": "/vercel.json", "destination": "/", "permanent": true },
    { "source": "/README.md", "destination": "/", "permanent": true },
    { "source": "/.gitignore", "destination": "/", "permanent": true },
    { "source": "/reports/:path*", "destination": "/", "permanent": true },

    { "source": "/services/", "destination": "/services.html", "permanent": true },
    { "source": "/guides/", "destination": "/guides.html", "permanent": true },
    { "source": "/sectors/", "destination": "/sectors.html", "permanent": true },
    { "source": "/projects/", "destination": "/projects.html", "permanent": true },
    { "source": "/about/", "destination": "/about.html", "permanent": true },
    { "source": "/process/", "destination": "/process.html", "permanent": true },
    { "source": "/contact/", "destination": "/contact.html", "permanent": true },
    { "source": "/faq/", "destination": "/faq.html", "permanent": true },
    { "source": "/testimonials/", "destination": "/testimonials.html", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy.html", "permanent": true },
    { "source": "/services/:slug/", "destination": "/services/:slug.html", "permanent": true },
    { "source": "/guides/:slug/", "destination": "/guides/:slug.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/(assets/.*|styles.css|main.js|favicon.ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
